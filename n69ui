#!/bin/bash
# Open the N69 desktop control.
set -euo pipefail
root="$(cd "$(dirname "$0")" && pwd)"
case "${1:-}" in
    logs|summary|compare|share|coverage) exec python3 "$root/ios16se_cli.py" "$@" ;;
esac
cd "$root"
if ! python3 -c "import customtkinter" >/dev/null 2>&1; then
    python3 -m pip install --user customtkinter
fi
exec python3 n69_ui.py
